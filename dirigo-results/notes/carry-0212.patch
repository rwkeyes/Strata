@@ -0,0 +1,119 @@
+"""Tests for the per-request code/prose retune (Service.code_tune_sampling).
+
+Run: .venv/bin/python -m pytest serve/test_code_tune.py -q
+
+The contract that matters: off changes nothing, shadow changes nothing but counts, on sets only the engine's
+per-request keys, a caller's own tuning always wins, and nothing in here can fail a request.
+"""
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from serve import server as S  # noqa: E402
+
+CODE_TEXT = "Write a Python function that reverses a linked list, with a test."
+PROSE_TEXT = "Explain why the sky is blue, in one paragraph."
+
+
+class Tok:
+    def __init__(self, text="", fail=False):
+        self.text, self.fail = text, fail
+
+    def decode(self, ids, errors="replace"):
+        if self.fail:
+            raise RuntimeError("tokenizer is gone")
+        return self.text
+
+
+def service(text="", mode="off", profiles=None, fail=False):
+    svc = S.Service.__new__(S.Service)          # no __init__: only the fields this path touches
+    svc.tok = Tok(text, fail)
+    svc.code_tune_mode = mode
+    svc.code_tune_profiles = profiles or {}
+    svc.code_tune_stats = {"labelled": {"code": 0, "prose": 0}, "applied": {"code": 0, "prose": 0},
+                           "shadowed": {"code": 0, "prose": 0}, "last": None}
+    return svc
+
+
+PROFILES = {"code": {"spec_min_p": 0.5}, "prose": {"spec_min_p": 0.9}}
+
+
+def test_off_is_a_no_op():
+    svc = service(CODE_TEXT, "off", PROFILES)
+    sampling = {"temperature": 0}
+    assert S.Service.code_tune_sampling(svc, [1, 2, 3], sampling) is sampling
+    assert svc.code_tune_stats["labelled"] == {"code": 0, "prose": 0}
+
+
+def test_shadow_counts_and_does_not_apply():
+    svc = service(CODE_TEXT, "shadow", PROFILES)
+    sampling = {"temperature": 0}
+    out = S.Service.code_tune_sampling(svc, [1, 2, 3], sampling)
+    assert out is sampling and "strata_tune" not in out
+    assert svc.code_tune_stats["labelled"]["code"] == 1
+    assert svc.code_tune_stats["shadowed"]["code"] == 1
+    assert svc.code_tune_stats["applied"]["code"] == 0
+
+
+def test_on_applies_the_label_profile():
+    svc = service(CODE_TEXT, "on", PROFILES)
+    out = S.Service.code_tune_sampling(svc, [1, 2, 3], {"temperature": 0})
+    assert out["strata_tune"] == {"spec_min_p": 0.5}
+    assert out["temperature"] == 0                       # the rest of the request is untouched
+    svc = service(PROSE_TEXT, "on", PROFILES)
+    assert S.Service.code_tune_sampling(svc, [1], {})["strata_tune"] == {"spec_min_p": 0.9}
+
+
+def test_a_callers_own_setting_wins():
+    svc = service(CODE_TEXT, "on", PROFILES)
+    out = S.Service.code_tune_sampling(svc, [1], {"strata_tune": {"spec_min_p": 0.7, "pcie_frac": 0.2}})
+    assert out["strata_tune"] == {"spec_min_p": 0.7, "pcie_frac": 0.2}
+    assert svc.code_tune_stats["applied"]["code"] == 0
+
+
+def test_no_profile_for_the_label_changes_nothing():
+    svc = service(CODE_TEXT, "on", {"prose": {"spec_min_p": 0.9}})
+    sampling = {"temperature": 0}
+    assert S.Service.code_tune_sampling(svc, [1], sampling) is sampling
+    assert svc.code_tune_stats["labelled"]["code"] == 1
+
+
+def test_a_tokenizer_failure_never_fails_the_request():
+    svc = service("", "on", PROFILES, fail=True)
+    sampling = {"temperature": 0}
+    assert S.Service.code_tune_sampling(svc, [1], sampling) is sampling
+
+
+def test_set_code_tune_filters_to_the_engine_per_request_keys():
+    svc = service("", "on")
+    S.Service.set_code_tune(svc, "on", {"code": {"spec_min_p": "0.5", "dial": 3}, "prose": {"pcie_frac": 0.1},
+                                        "nonsense": {"spec_min_p": 9}})
+    assert svc.code_tune_profiles == {"code": {"spec_min_p": 0.5}, "prose": {"pcie_frac": 0.1}}
+    S.Service.set_code_tune(svc, "sometimes", None)
+    assert svc.code_tune_mode == "off" and svc.code_tune_profiles == {}
+
+
+def test_draft_depth_is_forwarded_per_request():
+    keys = S.StrataEngine.sampling_keys({"strata_tune": {"spec": 2}})
+    assert " spec=2" in keys, keys
+    for bad in (1, 0, -3, 33, True, "4", 4.5):
+        keys = S.StrataEngine.sampling_keys({"strata_tune": {"spec": bad}})
+        assert "spec=" not in keys, (bad, keys)
+
+
+def test_a_depth_profile_is_applied_and_floored_at_two():
+    svc = service(CODE_TEXT, "on", {"code": {"spec": 2}})
+    out = S.Service.code_tune_sampling(svc, [1], {})
+    assert out["strata_tune"] == {"spec": 2.0}
+    assert " spec=2" in S.StrataEngine.sampling_keys(out)
+
+
+def test_report_shape():
+    svc = service(CODE_TEXT, "shadow", PROFILES)
+    S.Service.code_tune_sampling(svc, [1], {})
+    rep = S.Service.code_tune_report(svc)
+    assert rep["mode"] == "shadow" and rep["profiles"]["code"]["spec_min_p"] == 0.5
+    assert rep["labelled"]["code"] == 1 and "last" not in rep
diff --git a/serve/test_conv_router.py b/serve/test_conv_router.py
new file mode 100644
index 000000000..41e687466
--- /dev/null
+++ b/serve/test_conv_router.py
@@ -0,0 +1,113 @@
+"""Tests for serve/conv_router.py — the per-request cache decision.
+
+The router spends 120 ms to save 5 s, so its failure modes matter: a wrong "off" costs a full re-prefill on the next
+repeat, a wrong "on" wastes 120 ms.  These tests pin the bias (keep the cache), the hysteresis (a RUN of single-shot
+requests, not one), and the immediate switch back.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from serve.conv_router import BATCH, CHAT, Router  # noqa: E402
+
+
+def one(text="Summarise this document."):
+    return [{"role": "user", "content": text}]
+
+
+def chat(turns=2, first="Summarise this document."):
+    msgs = [{"role": "user", "content": first}]
+    for i in range(turns - 1):
+        msgs.append({"role": "assistant", "content": "ok"})
+        msgs.append({"role": "user", "content": f"and then? {i}"})
+    return msgs
+
+
+def test_one_single_request_keeps_the_cache():
+    r = Router(batch_after=4)
+    d = r.decide(one("a"))
+    assert d.mode == CHAT and not d.changed, "one single-shot request must never switch the cache off"
+
+
+def test_a_run_of_single_requests_switches_off():
+    r = Router(batch_after=4)
+    modes = [r.decide(one(f"prompt {i}")).mode for i in range(4)]
+    assert modes == [CHAT, CHAT, CHAT, BATCH], modes
+    last = r.decide(one("prompt 5"))
+    assert last.mode == BATCH and not last.changed, "already in batch: no repeated switching"
+
+
+def test_a_conversational_request_switches_back_immediately():
+    r = Router(batch_after=3)
+    for i in range(3):
+        r.decide(one(f"p{i}"))
+    assert r.mode == BATCH
+    d = r.decide(chat(2))
+    assert d.mode == CHAT and d.changed and d.wanted_cache == r.cache_on
+    assert r.consecutive_single == 0
+
+
+def test_the_counter_resets_on_a_conversational_request():
+    r = Router(batch_after=3)
+    r.decide(one("a"))
+    r.decide(one("b"))
+    r.decide(chat(2))               # resets
+    r.decide(one("c"))
+    r.decide(one("d"))
+    assert r.mode == CHAT, "two singles after a conversation must not trip a threshold of three"
+
+
+def test_tools_alone_mean_chat():
+    r = Router(batch_after=2)
+    d = r.decide(one("look this up"), tools=[{"type": "function", "function": {"name": "f"}}])
+    assert d.mode == CHAT and "tools" in d.reason
+
+
+def test_a_repeat_prefix_means_chat_even_when_single_turn():
+    r = Router(batch_after=2)
+    r.decide(one("the same document"))
+    r.decide(one("another document"))
+    assert r.mode == BATCH, "two singles trip the threshold"
+    d = r.decide(one("the same document"))     # same first turn as request 1
+    assert d.mode == CHAT and "repeat" in d.reason and d.changed
+
+
+def test_prefix_key_ignores_whitespace_and_tracks_content():
+    a = Router.prefix_key(one("hello   world\n"))
+    b = Router.prefix_key(one("hello world"))
+    c = Router.prefix_key(one("hello worlds"))
+    assert a == b and a != c
+
+
+def test_prefix_key_survives_a_content_list_and_none():
+    assert Router.prefix_key([{"role": "user", "content": [{"type": "text", "text": "hi there"}]}])
+    assert Router.prefix_key([{"role": "system", "content": "x"}]) == ""
+    assert Router.prefix_key(None) == ""
+
+
+def test_a_refused_switch_rolls_back():
+    r = Router(batch_after=2)
+    r.decide(one("a"))
+    d = r.decide(one("b"))
+    assert d.mode == BATCH
+    r.revert()                                  # the engine refused the tune
+    assert r.mode == CHAT
+    d2 = r.decide(one("c"))
+    assert d2.mode == CHAT, "after a rollback the next request must not think it is already in batch"
+
+
+def test_report_counts_every_request():
+    r = Router(batch_after=2)
+    r.decide(one("a"))
+    r.decide(one("b"))
+    r.decide(chat(2))
+    rep = r.report()
+    assert rep["requests"] == 3 and rep["switches_off"] == 1 and rep["switches_on"] == 1
+    assert rep["chat"] + rep["batch"] == 3
+
+
+def test_the_prefix_history_is_bounded():
+    r = Router(repeat_window=8)
+    for i in range(50):
+        r.decide(one(f"prompt {i}"))
+    assert len(r.seen) <= 8
diff --git a/serve/test_prompt_kind.py b/serve/test_prompt_kind.py
new file mode 100644
index 000000000..af9c97724
--- /dev/null
+++ b/serve/test_prompt_kind.py
@@ -0,0 +1,167 @@
+"""Tests for serve/prompt_kind.py - the label a per-request retune keys on.
+
+Run: .venv/bin/python -m pytest serve/test_prompt_kind.py -q
+The cases are realistic prompts, not strings built to satisfy the regexes: a classifier that only passes its
+own examples would move the draft floor on the wrong requests, which is worse than not moving it at all.
+"""
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from serve import prompt_kind as PK  # noqa: E402
+
+CODE_PROMPTS = [
+    "Write a Python function that reverses a singly linked list in place.",
+    "fix the failing test in src/parser.py",
+    "Refactor this class so the retry logic lives in one method:\n\n"
+    "```python\nclass Client:\n    def get(self, url):\n        for i in range(3):\n            try:\n"
+    "                return self._do(url)\n            except TimeoutError:\n                continue\n```",
+    "Why does this panic?\n\nTraceback (most recent call last):\n  File \"main.py\", line 12, in <module>\n"
+    "    run(cfg[\"retries\"])\nKeyError: 'retries'",
+    "Add a --dry-run flag to the deploy script and a test for it.",
+    "diff --git a/serve/server.py b/serve/server.py\n--- a/serve/server.py\n+++ b/serve/server.py\n@@ -1,3 +1,4 @@\n"
+    " x = 1\n+y = 2",
+    "SELECT customer_id, SUM(total) FROM orders GROUP BY customer_id HAVING SUM(total) > 1000;"
+    " -- make this faster for 40M rows",
+    "Implement a rate limiter middleware for our express app, token bucket, 100 req/min per key.",
+    "the build fails with `cannot find -lmkl_sequential` when I run ninja -C build-sycl-aot; what do I change in CMakeLists?",
+    "Convert this bash snippet to Python:\n\nfor f in *.gguf; do echo \"$f\"; done",
+]
+
+PROSE_PROMPTS = [
+    "Explain why the sky is blue.",
+    "Summarize the plot of Hamlet in three sentences.",
+    "What are the main trade-offs between consistency and availability in distributed systems, and why does the "
+    "choice depend on the workload? Please answer in a paragraph or two.",
+    "Write a short email to a customer explaining that their refund will take five business days.",
+    "Compare the tone of the two reviews and say which one is more persuasive.",
+    "Plan a five-day trip to Lisbon for someone who likes food markets and walking, with one day trip.",
+    "Why do some people prefer analog photography when digital is cheaper and more convenient? Consider the "
+    "craft, the workflow, and the look of the images, and explain how those factors interact.",
+    "Brainstorm names for a small coffee roastery that sells only single-origin beans.",
+]
+
+
+def test_code_prompts_are_code():
+    wrong = [(p[:40], str(PK.classify(p))) for p in CODE_PROMPTS if PK.classify(p).kind != PK.CODE]
+    assert not wrong, wrong
+
+
+def test_prose_prompts_are_prose():
+    wrong = [(p[:40], str(PK.classify(p))) for p in PROSE_PROMPTS if PK.classify(p).kind != PK.PROSE]
+    assert not wrong, wrong
+
+
+def test_empty_is_prose():
+    for text in ("", "   \n\n ", None):
+        assert PK.classify(text or "").kind == PK.PROSE
+
+
+def test_fence_alone_is_code():
+    text = "What does this do?\n```\nSELECT 1;\n```"
+    assert PK.classify(text).kind == PK.CODE
+
+
+def test_message_list_uses_the_last_user_turn():
+    msgs = [{"role": "user", "content": "Write a Rust function that dedups a Vec<u32>."},
+            {"role": "assistant", "content": "Sure - here it is."},
+            {"role": "user", "content": "Now write a test for it."}]
+    assert PK.classify_messages(msgs).kind == PK.CODE
+
+
+def test_continued_question_keeps_the_kind_of_what_precedes_it():
+    code = "def dedup(xs):\n    seen = set()\n    out = []\n    for x in xs:\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    return out"
+    msgs = [{"role": "user", "content": "Write a Python dedup function.\n" + code},
+            {"role": "assistant", "content": "Here it is."},
+            {"role": "user", "content": "Does it keep the original order? Explain your reasoning briefly."}]
+    assert PK.classify_messages(msgs).kind == PK.CODE, PK.classify_messages(msgs)
+
+
+def test_no_user_turn_is_prose():
+    assert PK.classify_messages([{"role": "system", "content": "be brief"}]).kind == PK.PROSE
+    assert PK.classify_messages([]).kind == PK.PROSE
+
+
+def test_image_parts_carry_no_text():
+    msgs = [{"role": "user", "content": [{"type": "image_url", "image_url": {"url": "data:image/png;base64,AA"}}]}]
+    assert PK.classify_messages(msgs).kind == PK.PROSE
+
+
+def test_reasons_are_reported_and_signed():
+    lab = PK.classify("fix the bug in main.go")
+    assert lab.kind == PK.CODE
+    assert lab.reasons and lab.score > 0
+    assert str(lab).startswith("code")
+    lab = PK.classify("Describe the smell of rain.")
+    assert lab.kind == PK.PROSE and lab.score < PK.THRESHOLD
+
+
+def test_prose_about_code_is_still_prose_when_nothing_is_asked():
+    text = ("I have been reading about how compilers allocate registers, and I find the graph colouring "
+            "approach beautiful, though I do not fully understand why spilling is unavoidable in some cases "
+            "and what the trade-offs are for a large function with many live values.")
+    assert PK.classify(text).kind == PK.PROSE, PK.classify(text)
+
+class MeasuredFailures(unittest.TestCase):
+    """The three prompts the accuracy campaign caught the suppressed arm answering WRONG (2026-11-04).
+
+    Each asks so directly that the wording alone reads "short answer", and each needs the scratchpad to be right:
+    the gate must keep their thinking. They are here so it cannot be relaxed back.
+    """
+
+    def test_divisibility_keeps_thinking(self):
+        self.assertEqual(PK.wants_direct_answer("Is 91 divisible by 7? Reply yes or no.").kind, "reason")
+
+    def test_unit_conversion_keeps_thinking(self):
+        self.assertEqual(PK.wants_direct_answer(
+            "Convert 2048 MiB to GiB. Reply with the number only.").kind, "reason")
+
+    def test_field_order_keeps_thinking(self):
+        self.assertEqual(PK.wants_direct_answer(
+            "Return only one CSV line with these fields in order: host=buildbox port=8095 gpu=B70").kind, "reason")
+
+    def test_plain_extraction_is_still_suppressed(self):
+        for text in ("Reply with only the invoice number.\n\nMemo: INV-4471 was issued on Tuesday.",
+                     "Reply with only the port.\n\nconfig: host=192.0.2.4 port=8095 retries=3",
+                     "Reply with only the email address.\n\nContact: Sam Rivera, someone@example.com."):
+            self.assertEqual(PK.wants_direct_answer(text).kind, "direct", text[:40])
+
+
+if __name__ == "__main__":
+    unittest.main()
+
+
+def test_classify_does_not_raise_on_junk():
+    """The docstring promises it never raises; a caller passing None or a number must get prose, not a TypeError."""
+    for junk in (None, 123, b"bytes", [], {}):
+        got = PK.classify(junk)
+        assert got.kind == PK.PROSE, junk
+        assert got.score == 0.0, junk
+
+
+def test_classify_messages_agrees_with_classify_of_messages_text():
+    """The two public entry points share one reader; this is what proves it."""
+    cases = [
+        [{"role": "user", "content": "def f(x):\n    return x + 1\nWrite a unit test for this."}],
+        [{"role": "user", "content": "Explain what this does"}],
+        [{"role": "user", "content": "def parse(s):\n    return s.split(',')"},
+         {"role": "assistant", "content": "It splits a line."},
+         {"role": "user", "content": "Now make it handle quotes"}],
+        [{"role": "system", "content": "you are terse"}],
+        [],
+    ]
+    for messages in cases:
+        a = PK.classify_messages(messages)
+        b = PK.classify(PK.messages_text(messages))
+        assert a.kind == b.kind, messages
+        assert a.score == b.score, messages
+
+
+def test_messages_without_a_user_turn_say_why():
+    got = PK.classify_messages([{"role": "system", "content": "hi"}])
+    assert got.kind == PK.PROSE
+    assert "no user turn" in got.reasons
+    assert PK.messages_text([{"role": "system", "content": "hi"}]) == ""
diff --git a/serve/test_short_spec.py b/serve/test_short_spec.py
new file mode 100644
index 000000000..6a65d3055
--- /dev/null
+++ b/serve/test_short_spec.py
@@ -0,0 +1,76 @@
+"""The short-answer depth rule: spec=4 when the ANSWER BUDGET is short, never when the client said otherwise.
+
+Measured on the B70 (Arc Pro B70, Qwen3.8-flash-next-coder IQ1_M, 20 extraction prompts x 2 rounds): at
+max_tokens 8, spec=4 against the start-up 6 is +11.3 % decode (34/40 pairs, both rounds positive) and -1.9 %
+wall. At max_tokens 128 the same change is a loss, which is why the rule keys on max_tokens and not on the
+prompt kind.
+"""
+import unittest
+
+from serve.server import Service, StrataEngine
+
+
+class Stub:
+    def __init__(self):
+        self.short_spec = 4
+        self.short_spec_max_tokens = 16
+        self.short_spec_stats = {"applied": 0, "last": None}
+
+
+apply = Service.apply_short_spec   # unbound: the stub supplies self
+
+
+class ShortAnswerDepth(unittest.TestCase):
+    def setUp(self):
+        self.svc = Stub()
+
+    def test_short_budget_gets_the_deeper_chain(self):
+        out = apply(self.svc, {"temperature": 0}, 8)
+        self.assertEqual(out["strata_tune"]["spec"], 4)
+        self.assertEqual(self.svc.short_spec_stats["applied"], 1)
+        self.assertIn("spec=4", StrataEngine.sampling_keys(out))
+
+    def test_boundary_is_inclusive(self):
+        self.assertIn("strata_tune", apply(self.svc, {}, 16))
+        self.assertNotIn("strata_tune", apply(self.svc, {}, 17))
+
+    def test_long_budget_untouched(self):
+        self.assertNotIn("strata_tune", apply(self.svc, {"temperature": 0}, 128))
+
+    def test_client_wins(self):
+        out = apply(self.svc, {"strata_tune": {"spec": 6}}, 8)
+        self.assertEqual(out["strata_tune"]["spec"], 6)
+        self.assertEqual(self.svc.short_spec_stats["applied"], 0)
+
+    def test_client_tune_is_kept_and_extended(self):
+        out = apply(self.svc, {"strata_tune": {"pcie_frac": 0.3}}, 8)
+        self.assertEqual(out["strata_tune"], {"pcie_frac": 0.3, "spec": 4})
+
+    def test_input_not_mutated(self):
+        given = {"strata_tune": {"pcie_frac": 0.3}}
+        apply(self.svc, given, 8)
+        self.assertNotIn("spec", given["strata_tune"])
+
+    def test_off_by_default(self):
+        self.svc.short_spec = 0
+        self.assertNotIn("strata_tune", apply(self.svc, {}, 8))
+
+    def test_no_budget(self):
+        for max_new in (0, None):
+            self.assertNotIn("strata_tune", apply(self.svc, {}, max_new))
+
+    def test_engine_never_gets_a_depth_it_cannot_have(self):
+        self.assertNotIn("spec=", StrataEngine.sampling_keys({"strata_tune": {"spec": 99}}))
+        self.assertNotIn("spec=", StrataEngine.sampling_keys({"strata_tune": {"spec": 1}}))
+        self.assertNotIn("spec=", StrataEngine.sampling_keys({"strata_tune": {"spec": True}}))
+
+    def test_set_short_spec_sanitises(self):
+        svc = Stub()
+        Service.set_short_spec(svc, "4", 0)          # a JSON string, a zero threshold
+        self.assertEqual((svc.short_spec, svc.short_spec_max_tokens), (0, 16))
+        Service.set_short_spec(svc, 4, 8)
+        self.assertEqual((svc.short_spec, svc.short_spec_max_tokens), (4, 8))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/serve/test_spec_window.py b/serve/test_spec_window.py
new file mode 100644
index 000000000..af2d715cb
--- /dev/null
+++ b/serve/test_spec_window.py
@@ -0,0 +1,96 @@
+"""The draft-window rule: downshift for ordinary requests, keep the start-up depth for retrieval.
+
+Measured on the B70 (Arc Pro B70, Qwen3.8-flash-next-coder IQ1_M, engine 0.1.58, 2026-11-07, two interleaved
+pairs with bench_prefill.py + strata-longprobe.py): spec 4 against the deployed 6 is +5.0 % fresh 4.2 k,
++3.6 % fresh 8.8 k, +7.5 % follow-up 4.5 k decode, and -9.9 % on a 7.8 k retrieval needle.  So the rule cannot
+be one constant: it keys on whether the prompt is retrieval-shaped.
+"""
+import unittest
+
+from serve.server import Service, StrataEngine, TUNE_PROMPT_TAIL
+
+
+class Stub:
+    def __init__(self, text=""):
+        self.spec_window_down = 4
+        self.spec_window_needle_min = 6000
+        self.spec_window_stats = {"downshifted": 0, "kept": 0, "last": None}
+        self.tok = type("Tok", (), {"decode": staticmethod(lambda ids, errors=None: text)})()
+
+
+apply = Service.spec_window_sampling    # unbound: the stub supplies self
+
+
+class SpecWindow(unittest.TestCase):
+    def setUp(self):
+        self.svc = Stub("Summarise this note in three bullets.")
+
+    def test_ordinary_prompt_is_downshifted(self):
+        out = apply(self.svc, list(range(4000)), {"temperature": 0})
+        self.assertEqual(out["strata_tune"]["spec"], 4)
+        self.assertEqual(self.svc.spec_window_stats["downshifted"], 1)
+        self.assertIn("spec=4", StrataEngine.sampling_keys(out))
+
+    def test_long_retrieval_prompt_keeps_the_startup_depth(self):
+        self.svc.tok = type("Tok", (), {"decode": staticmethod(
+            lambda ids, errors=None: "Question: under which reference is the certificate filed?")})()
+        out = apply(self.svc, list(range(7000)), {"temperature": 0})
+        self.assertNotIn("strata_tune", out)
+        self.assertEqual(self.svc.spec_window_stats["kept"], 1)
+
+    def test_a_long_prompt_without_a_question_is_not_retrieval(self):
+        out = apply(self.svc, list(range(20000)), {"temperature": 0})
+        self.assertEqual(out["strata_tune"]["spec"], 4)
+
+    def test_a_short_question_is_not_retrieval(self):
+        self.svc.tok = type("Tok", (), {"decode": staticmethod(lambda ids, errors=None: "What is 17*23?")})()
+        out = apply(self.svc, list(range(300)), {"temperature": 0})
+        self.assertEqual(out["strata_tune"]["spec"], 4)
+
+    def test_client_spec_wins(self):
+        out = apply(self.svc, list(range(4000)), {"strata_tune": {"spec": 6}})
+        self.assertEqual(out["strata_tune"]["spec"], 6)
+        self.assertEqual(self.svc.spec_window_stats["downshifted"], 0)
+
+    def test_client_tune_is_kept_and_extended(self):
+        out = apply(self.svc, list(range(4000)), {"strata_tune": {"spec_min_p": 0.4}})
+        self.assertEqual(out["strata_tune"], {"spec_min_p": 0.4, "spec": 4})
+
+    def test_off_means_untouched(self):
+        self.svc.spec_window_down = 0
+        self.assertNotIn("strata_tune", apply(self.svc, list(range(4000)), {"temperature": 0}))
+
+    def test_no_ids_untouched(self):
+        self.assertNotIn("strata_tune", apply(self.svc, [], {"temperature": 0}))
+
+    def test_decode_failure_does_not_fail_the_request(self):
+        def boom(ids, errors=None):
+            raise RuntimeError("no tokenizer")
+        self.svc.tok = type("Tok", (), {"decode": staticmethod(boom)})()
+        out = apply(self.svc, list(range(4000)), {"temperature": 0})
+        self.assertNotIn("strata_tune", out)
+
+    def test_setter_clamps_and_reports(self):
+        svc = Stub()
+        Service.set_spec_window(svc, 99, 1000)
+        self.assertEqual(svc.spec_window_down, 8)
+        self.assertEqual(svc.spec_window_needle_min, 1000)
+        Service.set_spec_window(svc, "not a number")
+        self.assertEqual(svc.spec_window_down, 0)
+        rep = Service.spec_window_report(svc)
+        self.assertEqual(rep["down"], 0)
+        self.assertIn("downshifted", rep)
+
+    def test_only_the_prompt_tail_is_read(self):
+        seen = {}
+
+        def grab(ids, errors=None):
+            seen["n"] = len(ids)
+            return "x"
+        self.svc.tok = type("Tok", (), {"decode": staticmethod(grab)})()
+        apply(self.svc, list(range(50000)), {"temperature": 0})
