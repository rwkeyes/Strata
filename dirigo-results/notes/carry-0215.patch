index 000000000..f1f4ee39a
--- /dev/null
+++ b/scripts/spec-min-p-pair.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Settle one setting with paired samples on the SERVING prompt, at the SERVING window.
+
+    python3 scripts/spec-min-p-pair.py [--a 0.5] [--b 0.7] [--pairs 10] [--max-tokens 128] [--port 8095]
+
+Why it exists: on this box the calibration's prose prompt put spec_min_p 0.7 five percent ahead, the calibrator's
+code prompt put it five percent behind, and two live reads at 64 and 128 tokens disagreed again.  Three shapes, three
+answers — so the question is not "which number wins in the calibrator", it is "which number wins on the traffic this
+box actually serves", asked with enough pairs to say.
+
+Method: alternating order (A/B, then B/A), one pair per round, decode rate measured from the first streamed token to
+the last (prefill excluded), tokens counted in content AND reasoning.  The ordering alternates so drift lands on both
+values equally; the verdict is the median paired difference plus a sign test, because with ten pairs the sign count is
+the honest statistic.
+
+The box must be quiet: it reads GET /v1/tuning's request counters before and after and subtracts its own requests.
+"""
+import argparse
+import statistics
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import serving_measure as sm  # noqa: E402
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--a", type=float, default=0.5)
+    ap.add_argument("--b", type=float, default=0.7)
+    ap.add_argument("--setting", default="spec_min_p")
+    ap.add_argument("--pairs", type=int, default=10)
+    ap.add_argument("--max-tokens", type=int, default=128)
+    ap.add_argument("--port", type=int, default=8095)
+    ap.add_argument("--prompt-file", type=Path, default=sm.default_prompt_file())
+    ap.add_argument("--chars", type=int, default=sm.DEFAULT_CHARS)
+    ap.add_argument("--model", default=sm.DEFAULT_MODEL)
+    a = ap.parse_args()
+
+    base = f"http://127.0.0.1:{a.port}"
+    before = sm.get(base, "/v1/tuning").get("requests") or {}
+    if before.get("busy"):
+        print(f"busy: {before['busy']} request(s) in flight — not measuring a box someone is using", file=sys.stderr)
+        return 2
+
+    text = sm.load_prompt(a.prompt_file, a.chars)
+    mine = 0
+
+    def once(value: float) -> float:
+        nonlocal mine
+        mine += 1
+        return sm.stream_rate(base, text, max_tokens=a.max_tokens, model=a.model,
+                              tune={a.setting: value})
+
+    for _ in range(2):                      # discarded: the first answers after a setting change are slow
+        once(a.a)
+        once(a.b)
+
+    deltas, ra, rb = [], [], []
+    for i in range(a.pairs):
+        order = [a.a, a.b] if i % 2 == 0 else [a.b, a.a]
+        got = {value: once(value) for value in order}
+        if not got[a.a] or not got[a.b]:
+            continue
+        ra.append(got[a.a])
+        rb.append(got[a.b])
+        deltas.append(got[a.b] - got[a.a])
+        print(f"pair {len(deltas):2d}: {a.a} {got[a.a]:6.2f}  {a.b} {got[a.b]:6.2f}   "
+              f"delta {got[a.b] - got[a.a]:+6.2f} ({(got[a.b] - got[a.a]) / got[a.a] * 100:+.1f}%)")
+
+    after = sm.get(base, "/v1/tuning").get("requests") or {}
+    foreign = (after.get("served", 0) - before.get("served", 0)) - mine
+    if foreign:
+        print(f"NOTE: {foreign} other request(s) arrived during the run — treat the numbers with suspicion",
+              file=sys.stderr)
+
+    if len(deltas) < 5:
+        print("too few usable pairs", file=sys.stderr)
+        return 2
+    b_better = sum(1 for d in deltas if d > 0)
+    med = statistics.median(deltas)
+    med_pct = med / statistics.median(ra) * 100
+    print()
+    print(f"{a.setting}: {a.a} median {statistics.median(ra):.2f} tok/s, "
+          f"{a.b} median {statistics.median(rb):.2f} tok/s over {len(deltas)} pairs")
+    print(f"median paired delta {med:+.2f} tok/s ({med_pct:+.2f}%), {b_better} of {len(deltas)} pairs favour {a.b}")
+    verdict = "no difference" if abs(med_pct) < 3 else (f"{a.b} wins" if med > 0 else f"{a.a} wins")
+    if abs(b_better - len(deltas) / 2) < 2:
+        verdict = "no difference (sign test split)"
+    print(f"verdict: {verdict}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/strata-codetune-probe.py b/scripts/strata-codetune-probe.py
new file mode 100644
index 000000000..a195aaa5e
--- /dev/null
+++ b/scripts/strata-codetune-probe.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Does a per-request `spec_min_p` help CODE prompts more than PROSE prompts?  Paired, on one loaded engine.
+
+The engine accepts `spec_min_p` as a PER-REQUEST key (`src/program/generate.cpp`, "req_spec_min_p"), so this
+needs no restart per value: one engine, every prompt measured at every value, paired by prompt.  That is the
+only honest shape for a knob whose effect the skill already records as prompt-dependent (the calibrator's code
+shape read 0.7 as 2.7% slower while the serving prompt read it 12% faster).
+
+Timings come from the engine's own completion line, not from the client:
+    prompt N tokens = R reused + F read in P ms (X tok/s), G generated in D ms (Y tok/s)
+so the decode column is the engine's accounting.  Judge on DECODE (speculation), and note that prefill for the
+same prompt is served from the conversation cache after its first request - that is why decode is the lane.
+
+    .venv/bin/python strata-codetune-probe.py --model qwen3.8-flash-next-coder-iq1_m \\
+        --engine-log <tree>/strata-coder-iq1_m-sycl-tuned.log --out ~/strata-codetune-probe.json
+
+UNDO: rm ~/bin/strata-codetune-probe.py
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import statistics
+import time
+import urllib.request
+from pathlib import Path
+
+PATTERN = re.compile(r"prompt (\d+) tokens = (\d+) reused \+ (\d+) read in (\d+) ms \(([0-9.]+) tok/s\), "
+                     r"(\d+) generated in (\d+) ms \(([0-9.]+) tok/s\)")
+FIELDS = ("prompt_tokens", "reused", "fresh", "prefill_ms", "prefill_tps", "generated", "decode_ms", "decode_tps")
+
+CODE = [
+    "Write a Python function that returns the k largest elements of a list, with type hints and a docstring.",
+    "Refactor this handler so the file is closed even when read raises:\n\n"
+    "```python\ndef load(p):\n    f = open(p)\n    return f.read()\n```",
+    "Fix the failing test and say in one sentence what the bug was:\n\n"
+    "```python\ndef test_sum():\n    assert add(2, 2) == 5\n```",
+    "Write a bash one-liner that lists the ten largest .gguf files under /data with their sizes.",
+    "Implement a token-bucket rate limiter class in Python and a test for it.",
+    "Why does this query return duplicates? SELECT a.id FROM a JOIN b ON a.id = b.id -- one row per id expected",
+]
+EXTRACT = [
+    "In the memo below, reply with the invoice number only.\n\nMemo: INV-4471 was issued on Tuesday; the total is 1 240 dollars.",
+    "Extract the email address from this text and return only it: contact sam at someone@example.com before Friday.",
+    "Reply with yes or no: is 2^31 - 1 prime?",
+    "Convert this JSON to YAML and output nothing else: {\"build\": \"green\", \"tests\": 56}",
+    "Translate this sentence into French, only the translation: the build is green and the tests pass.",
+    "What is the value of timeout_s in this config? Reply with the number only.\n\n[server]\nport = 8095\ntimeout_s = 45\nretries = 3",
+    "Reply with only the port number from this line: the server listens on 127.0.0.1:8095.",
+    "Extract the date and output it as ISO 8601 only: published on Tuesday, 4 November 2026.",
+    "Answer with a single word, positive or negative: is 91 divisible by 7?",
+    "Return only the number of tests that failed: 56 tests ran, 2 failed, 54 passed.",
+    "Translate into German, output only the translation: the card is idle.",
+    "Reply with the three-letter extension of file 'archive.tar.gz' and nothing else.",
+    "Convert to a JSON object only: name=buildbox, gpu=B70, port=8095.",
+    "Reply with yes or no: does the string 'abc' contain the letter 'd'?",
+    "Extract the version string only: engine 0.1.56 was built on 4 November.",
+    "Output only the sum: 17 + 25 + 8.",
+    "Reply with the last word of this sentence, nothing else: the logs are clean today.",
+    "Return only the key names in this config, comma separated: port=8095, timeout=45, retries=3.",
+    "Reply with the capital of Portugal and nothing else.",
+    "Extract the SHA prefix only: commit 67cc893e fixed the policy.",
+]
+COPY = [
+    "Rewrite the paragraph below in the same structure, changing every mention of \"buildbox\" to \"the build box\":\n\n"
+    "buildbox serves the engine on :8095. buildbox runs a B70 and a 7700X. buildbox keeps its packs on a USB volume. "
+    "When buildbox reboots the unit waits for that volume.",
+    "Translate the passage below into French, keeping the line breaks:\n\nthe build is green\nthe tests pass\n"
+    "the card is idle\nthe logs are clean",
+    "Convert this YAML to JSON exactly, keys and all:\n\nserver:\n  port: 8095\n  timeout_s: 45\n  retries: 3",
+    "Apply this patch by returning the whole file with the change made:\n\n```diff\n-    return x + 1\n+    return x - 1\n```\n\n"
+    "```python\ndef step(x):\n    return x + 1\n```",
+    "Copy the table below and add one row for 2026 with the same columns:\n\n| year | builds | failures |\n|---|---|---|\n"
+    "| 2024 | 41 | 2 |\n| 2025 | 63 | 1 |",
+    "Restate the rules below as a numbered list, same wording, no additions:\n\nOne request runs at a time. "
+    "The card holds one model. A stop must free VRAM before a start. A failed start is not retried on a timer.",
+]
+PROSE = [
+    "Explain why the sky is blue, in one paragraph.",
+    "Summarize the trade-offs between consistency and availability in distributed systems.",
+    "Write a short email telling a customer their refund will take five business days.",
+    "Which is more persuasive in an argument, a story or a statistic, and why?",
+    "Plan a five-day trip to Lisbon focused on food markets and walking.",
+    "Why do some people prefer analog photography when digital is cheaper and more convenient?",
+]
+
+
+def one(url, model, text, tune, log_path, key="spec_min_p", effort="none", max_tokens=128, timeout=360):
+    """One greedy request; returns the engine's own timing line as a dict."""
+    offset = log_path.stat().st_size
+    body = {"model": model, "messages": [{"role": "user", "content": text}], "max_tokens": max_tokens,
+            "temperature": 0, "top_k": 1, "top_p": 1, "min_p": 0, "seed": 42}
+    if effort != "auto":
+        body["reasoning_effort"] = effort
+    if tune is not None:
+        body["strata_tune"] = {key: (float(tune) if key != "spec" else int(tune))}
+    headers = {"Content-Type": "application/json"}
+    if os.environ.get("STRATA_API_KEY"):
+        headers["Authorization"] = "Bearer " + os.environ["STRATA_API_KEY"]
+    req = urllib.request.Request(url.rstrip("/") + "/v1/chat/completions",
+                                 data=json.dumps(body).encode(), headers=headers)
+    t0 = time.monotonic()
+    with urllib.request.urlopen(req, timeout=timeout) as resp:
+        data = json.load(resp)
+    wall = time.monotonic() - t0
+    deadline = time.monotonic() + 2
+    matches = []
+    while True:
+        with log_path.open("rb") as fh:
+            fh.seek(offset)
+            matches = PATTERN.findall(fh.read().decode(errors="replace"))
+        if matches or time.monotonic() >= deadline:
+            break
+        time.sleep(0.02)
+    if len(matches) != 1:
+        raise RuntimeError(f"expected one engine timing line, saw {len(matches)} (idle server? wrong log?)")
+    metrics = dict(zip(FIELDS, map(float, matches[0])))
+    metrics["wall_s"] = round(wall, 2)
+    choice = data["choices"][0]
+    metrics["finish"] = choice.get("finish_reason")
+    msg = choice.get("message") or {}
+    metrics["content"] = (msg.get("content") or "")[:400]
+    metrics["reasoning"] = (msg.get("reasoning_content") or "")[:200]
+    return metrics
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--url", default="http://127.0.0.1:8097")
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--engine-log", type=Path, required=True)
+    ap.add_argument("--key", default="spec_min_p", help="the per-request key to sweep (spec_min_p | spec)")
+    ap.add_argument("--family", default="serving", choices=["serving", "extract", "copy"],
+                    help="serving: 6 code + 6 prose; extract: 6 short-direct-answer prompts")
+    ap.add_argument("--effort", default="none", choices=["none", "auto"],
+                    help="none: send reasoning_effort none (the old behaviour); auto: send none - let the server's "
+                         "thinking policy decide")
+    ap.add_argument("--values", default="0.3,0.5,0.7,0.9")
+    ap.add_argument("--served", type=float, default=None, help="the value the deployment currently uses")
+    ap.add_argument("--rounds", type=int, default=2)
+    ap.add_argument("--max-tokens", type=int, default=128, help="answer budget per request (default 128)")
+    ap.add_argument("--out", type=Path, default=Path.home() / "strata-codetune-probe.json")
+    a = ap.parse_args()
+    cast = int if a.key in ("spec", "lookup") else float
+    values = [None] if a.values.strip().lower() in ("none", "", "-") else [None] + [cast(v) for v in a.values.split(",")]
+    if a.max_tokens != 128:
+        print(f"max_tokens {a.max_tokens}", flush=True)
+    if a.served is None:
+        a.served = cast(6) if a.key == "spec" else 0.7
+    print(f"sweeping {a.key}: values {values} (None = the engine's own setting)", flush=True)
+    rows = []
+    for rnd in range(1, a.rounds + 1):
+        for value in values:
+            # the code and prose prompts alternate inside each value, so a thermal/cache drift cannot favour one
+            families = {"serving": (("code", CODE), ("prose", PROSE)),
+                        "extract": (("extract", EXTRACT),),
+                        "copy": (("copy", COPY),)}[a.family]
+            for kind, prompts in families:
+                for i, text in enumerate(prompts, 1):
+                    try:
+                        m = one(a.url, a.model, text, value, a.engine_log, a.key, a.effort, a.max_tokens)
+                    except Exception as e:                       # noqa: BLE001 - a failed request is a row, not a crash
+                        rows.append({"round": rnd, "value": value, "kind": kind, "prompt": i, "error": str(e)})
+                        print(f"  round {rnd} value {value} {kind}#{i}: ERROR {e}", flush=True)
+                        continue
+                    rows.append({"round": rnd, "value": value, "kind": kind, "prompt": i, **m})
+                    print(f"  round {rnd} value {value} {kind}#{i}: decode {m['decode_tps']:.1f} "
+                          f"prefill {m['prefill_tps']:.0f} gen {m['generated']:.0f}", flush=True)
+    a.out.write_text(json.dumps(rows, indent=1))
+    print(f"\nwrote {a.out} ({len(rows)} rows)")
+
+    # per kind and value: median decode, and the paired win rate against the served value
+    by = {}
+    for r in rows:
+        if "error" in r:
+            continue
+        by.setdefault((r["kind"], r["value"]), []).append(r["decode_tps"])
+    print("\n== decode tok/s, median of all rows (engine's own line)\n")
+    header = "kind  " + "".join(f"{'native' if v is None else v:>9}" for v in values)
+    print(header)
+    kinds_seen = sorted({k for k in {r["kind"] for r in rows if "error" not in r}})
+    for kind in kinds_seen:
+        cells = []
+        for v in values:
+            vals = by.get((kind, v), [])
+            cells.append(f"{statistics.median(vals):>9.1f}" if vals else f"{'-':>9}")
+        print(f"{kind:<6}" + "".join(cells))
+
+    print("\n== paired by prompt: the best value against the served one\n")
+    pairs = {}
+    for r in rows:
+        if "error" in r:
+            continue
+        pairs.setdefault((r["kind"], r["prompt"], r["round"]), {})[r["value"]] = r["decode_tps"]
+    for kind in kinds_seen:
+        for v in values:
+            if v is None or v == a.served:
+                continue
+            deltas, wins = [], 0
+            for (k, p, rnd), d in pairs.items():
+                if k != kind or v not in d or a.served not in d:
+                    continue
+                deltas.append(100.0 * (d[v] - d[a.served]) / d[a.served])
+                wins += d[v] > d[a.served]
+            if deltas:
+                print(f"  {kind:<6} {a.key}={v:<4} vs {a.served:g}: median {statistics.median(deltas):+6.1f} % "
+                      f"(range {min(deltas):+6.1f}..{max(deltas):+6.1f}), wins {wins}/{len(deltas)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/strata-drift-check.py b/scripts/strata-drift-check.py
new file mode 100644
index 000000000..1d9f6e704
--- /dev/null
+++ b/scripts/strata-drift-check.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""Has this box drifted away from its tuned baseline?  Cheap to run, cheap to trust.
+
+The question fine calibration answers is "is the machine still what the config was tuned for".  Most of the time it
+is, and 6½ minutes answers nothing.  This measures two numbers that move first — decode rate and TTFT — against the
+stored baseline for this model and hardware, and only says "re-run fine" when they have moved more than a threshold.
+
+    ~/bin/strata-drift-check.py                 # measure, compare, exit 0 (same) / 3 (drifted)
+    ~/bin/strata-drift-check.py --record        # (re)record today's numbers as the baseline
+    ~/bin/strata-drift-check.py --drift-pct 2   # a tighter threshold
+    ~/bin/strata-drift-check.py --run-fine      # when it has drifted, run the fine calibration itself
+
+Exit codes: 0 same (or baseline recorded), 2 the server is not answering, 3 drifted.
+
+It refuses to measure a busy box: `GET /v1/tuning` reports requests{served,busy}, and a measurement taken while
+someone else's prompt was in flight is not a measurement.  Idle means busy == 0 at the start AND `served` unchanged
+across the measurement.
+"""
+import argparse
+import json
+import os
+import statistics
+import subprocess
+import sys
+import time
+import urllib.request
+from pathlib import Path
+
+STATE = Path.home() / ".cache" / "strata-drift.json"
+# The measurement prompt is fixed ON PURPOSE: a baseline is only comparable with the prompt it was taken on.  It is
+# prose, not code, so a change in decode rate cannot be a change in how the model copies text.
+PROMPT = "Explain in a few sentences why PCIe bandwidth matters for a mixture-of-experts model."
+PORT = int(os.environ.get("STRATA_PORT", "8095"))
+
+
+def get(path: str) -> dict:
+    with urllib.request.urlopen(f"http://127.0.0.1:{PORT}{path}", timeout=10) as r:
+        return json.load(r)
+
+
+def requests_now() -> dict:
+    try:
+        return get("/v1/tuning").get("requests") or {}
+    except Exception:
+        return {}
+
+
+def key() -> str:
+    """model + hardware: a baseline belongs to one box and one model, never to a vendor."""
+    try:
+        st = get("/v1/status")
+    except Exception:
+        return "unknown"
+    hw = ""
+    try:
+        hw = get("/v1/tuning").get("hardware") or ""
+    except Exception:
+        pass
+    return f"{st.get('model', '?')}@{hw or st.get('engine', '?')}"
+
+
+def measure(max_tokens: int = 128, runs: int = 3) -> dict:
+    """decode tok/s and TTFT, straight from the streaming response (no log parsing, no engine assumptions)."""
+    body = json.dumps({"model": "m", "max_tokens": max_tokens, "stream": True, "temperature": 0.2,
+                       "messages": [{"role": "user", "content": PROMPT}]}).encode()
+    rates, ttfts = [], []
+    attempts = runs + 1
+    for _ in range(attempts):                     # the first answer after an idle spell is always slow
+        req = urllib.request.Request(f"http://127.0.0.1:{PORT}/v1/chat/completions", data=body,
+                                     headers={"Content-Type": "application/json"})
+        t0 = time.time()
+        first = last = None
+        n = 0
+        with urllib.request.urlopen(req, timeout=600) as r:
+            for raw in r:
+                if not raw.startswith(b"data: {"):
+                    continue
+                try:
+                    d = json.loads(raw[6:])
+                except Exception:
+                    continue
+                delta = (d.get("choices") or [{}])[0].get("delta") or {}
+                if delta.get("content") or delta.get("reasoning_content"):
+                    now = time.time()
+                    first = first or now
+                    last = now
+                    n += 1
+        if first and last and n > 3 and last > first:
+            rates.append((n - 1) / (last - first))
+            ttfts.append(first - t0)
+    if not rates:
+        return {}
+    return {"tok_s": round(statistics.median(rates), 2), "ttft_s": round(statistics.median(ttfts), 2),
+            "samples": len(rates), "attempts": attempts}
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--record", action="store_true")
+    ap.add_argument("--drift-pct", type=float, default=3.0)
+    ap.add_argument("--run-fine", action="store_true")
+    a = ap.parse_args()
+
+    try:
+        get("/v1/status")
+    except Exception as e:
+        print(f"the server is not answering on :{PORT} ({e})", file=sys.stderr)
+        return 2
+
+    before = requests_now()
+    if before.get("busy"):
+        print(f"busy: {before['busy']} request(s) in flight - not measuring a box someone is using", file=sys.stderr)
+        return 2
+    if (before.get("idle_s") or 0) < 3:
+        time.sleep(3)                              # let the last request's caches settle
+
+    k = key()
+    got = measure()
+    if not got:
+        print("no usable samples", file=sys.stderr)
+        return 2
+    after = requests_now()
+    mine = got.pop("attempts", 0)                  # the script's OWN requests: expected, not foreign traffic
+    if before.get("served") is not None and after.get("served") is not None:
+        foreign = (after["served"] - before["served"]) - mine
+        if foreign:
+            print(f"{foreign} other request(s) arrived during the measurement; the numbers are not comparable - "
+                  "run it again when the box is quiet", file=sys.stderr)
+            return 2
+
+    state = {}
+    if STATE.exists():
+        try:
+            state = json.loads(STATE.read_text())
+        except Exception:
+            state = {}
+    base = state.get(k)
+    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
+
+    if a.record or not base:
+        state[k] = {**got, "recorded": stamp}
+        STATE.parent.mkdir(parents=True, exist_ok=True)
+        STATE.write_text(json.dumps(state, indent=2))
+        print(f"{'recorded' if a.record else 'no baseline for this model+hardware yet, so this becomes it'}: "
+              f"{k} -> {got['tok_s']} tok/s, TTFT {got['ttft_s']} s")
+        return 0
+
+    drift = (got["tok_s"] - base["tok_s"]) / base["tok_s"] * 100
+    ttft_drift = (got["ttft_s"] - base["ttft_s"]) / base["ttft_s"] * 100
+    verdict = "DRIFTED" if abs(drift) >= a.drift_pct else "same"
+    print(f"{k}\n  baseline {base['recorded']}: {base['tok_s']} tok/s, TTFT {base['ttft_s']} s\n"
+          f"  now      {stamp}: {got['tok_s']} tok/s, TTFT {got['ttft_s']} s\n"
+          f"  decode {drift:+.1f}%, TTFT {ttft_drift:+.1f}%  -> {verdict} (threshold {a.drift_pct:g}%)")
+
+    if verdict != "DRIFTED":
+        return 0
+    print("\nA box that is slower than its baseline is either thermally changed, sharing the card, or on new "
+          "software.  Recording a new baseline hides a regression; a fine calibration re-measures every setting:")
+    if a.run_fine:
+        print("running the fine calibration now (one engine load, the service stops for ~1 minute)...")
+        rc = subprocess.call([str(Path.home() / "bin" / "fork-fastcal-run.sh")], env={**os.environ, "STRATA_CAL_FINE": "1"})
+        if rc == 0:
+            state[k] = {**got, "recorded": stamp}   # the calibration just proved these numbers
+            STATE.write_text(json.dumps(state, indent=2))
+        return rc
+    print("  STRATA_CAL_FINE=1 tools/calibrate.py <config>      (or re-run this with --run-fine)")
+    return 3
+
+
+if __name__ == "__main__":
+    sys.exit(main())
